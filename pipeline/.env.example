# Copy to .env and fill in real values. Never commit .env.
# Source before running:  source .env

# ---------- Google service account ----------
# Path to the JSON key file for the Drevi pipeline service account.
# The service account needs read+write on the Master Sheet and the four
# Drive folders below.
export GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/drevi-pipeline-sa.json"

# ---------- Drive folder IDs ----------
# Each is the ID portion of a Drive URL, e.g.
#   https://drive.google.com/drive/folders/<THIS_PART>
export DREVI_INPUT_FOLDER_ID=""           # Arushi's per-SKU upload folders live here
export DREVI_PROCESSED_FOLDER_ID=""       # Stage 1 writes here
export DREVI_TRYON_FOLDER_ID=""           # Stage 3 writes here
export DREVI_BRAND_MODEL_FOLDER_ID=""     # contains model-a/poses/ and model-b/poses/

# Optional: where Stage 2 saves its Claude-call backups. If unset, the
# pipeline auto-creates a 'VISION_LOGS' folder as a sibling of PROCESSED.
# export DREVI_VISION_LOGS_FOLDER_ID=""

# ---------- API keys ----------
export FASHN_API_KEY=""                   # tryon-max
export ANTHROPIC_API_KEY=""               # Claude Opus vision

# ---------- Shopify (Stage 4 — draft creation) ----------
# New Shopify model (May 2026): Dev Dashboard apps use OAuth client_credentials,
# not static tokens. Get the Client ID + Secret from:
#   https://dev.shopify.com → your organization → Apps → your app
#   → Settings → Credentials → copy Client ID, click eye icon to reveal Secret
# The script auto-fetches a 24h access token at runtime using these.
export SHOPIFY_STORE_DOMAIN=""            # e.g., drevi-fashion.myshopify.com
export SHOPIFY_CLIENT_ID=""               # hex string from Dev Dashboard
export SHOPIFY_CLIENT_SECRET=""           # revealed from Dev Dashboard
# export SHOPIFY_API_VERSION="2024-10"    # defaults to 2024-10 if unset
#
# Optional: hardcode the location ID for inventory_levels/set. Useful if
# the app can't get read_locations scope approved. Find it once in Shopify
# admin → Settings → Locations → click your location → the URL ends in
# /locations/<NUMBER>. Single-location stores only need this one value.
# export SHOPIFY_LOCATION_ID=""
#
# Image upload quality (Stage 4):
# By default FASHN's 4K output is uploaded UNMODIFIED to Shopify, preserving
# full resolution for zoomable embellishment shots. A safety-net downsample
# only triggers on files larger than DOWNSAMPLE_BYTES (default 8 MB), in
# which case the long edge is resized to FALLBACK_LONG_EDGE @ JPEG_QUALITY.
# export DREVI_SHOPIFY_IMAGE_DOWNSAMPLE_BYTES=8388608     # 8 MB
# export DREVI_SHOPIFY_IMAGE_FALLBACK_LONG_EDGE=4096      # px
# export DREVI_SHOPIFY_IMAGE_JPEG_QUALITY=95              # 1-100
#
# (Legacy: if you have a static shpat_ token from an older custom app, you can
# alternatively set SHOPIFY_ADMIN_API_TOKEN instead of Client ID + Secret.)
# export SHOPIFY_ADMIN_API_TOKEN=""       # shpat_xxxxxxxxxxxxx

# ---------- Optional tuning (defaults shown) ----------
# Stage 1 — HEIC conversion. Set to "0" to pass HEIC through unchanged.
# export DREVI_CONVERT_MANNEQUIN_HEIC=1
# export DREVI_CONVERT_DETAIL_HEIC=1
# export DREVI_JPEG_QUALITY=98

# Stage 2 — vision tunables.
# export DREVI_VISION_IMAGE_LONG_EDGE=1568
# export DREVI_VISION_IMAGE_QUALITY=88

# Stage 3 — FASHN tunables.
# export DREVI_FASHN_OUTPUT_FORMAT=png         # or jpeg
# export DREVI_FASHN_SUBMIT_RETRIES=2
# Poll window per job. 4k model-swap jobs can exceed the 180s default under
# FASHN load — raise this if you see "did not complete within Ns" timeouts.
# export DREVI_FASHN_POLL_TIMEOUT_SEC=300
# export DREVI_FASHN_POLL_INTERVAL_SEC=3

# Brand model fallback when Brand Model Map has no entry. Logged on use.
# export DREVI_DEFAULT_BRAND_MODEL=A
# export DREVI_DEFAULT_MOVEMENT_POSE=pose_06_turning

# Local working dir override (default: ~/drevi)
# export DREVI_LOCAL_ROOT=~/drevi
