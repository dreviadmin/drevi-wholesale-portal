      "scene": "home",
      "state": "home",
      "intent": "This is your home screen. New designs and the categories are right here.",
      "actions": [
        {
          "type": "point",
          "target": "home.chip.lehenga",
          "at": 1.2
        }
      ]
    },
    {
      "id": "c07",
      "scene": "home",
      "state": "home",
      "intent": "The menu is the three lines at the top left. Catalog, Cart and My Orders are all in there.",
      "actions": [
        {
          "type": "scroll",
          "to": 0,
          "over": [
            0.0,
            0.3
          ]
        },
        {
          "type": "tap",
          "target": "home.menu",
