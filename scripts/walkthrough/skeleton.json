{
  "_readme": "Clip skeleton for the portal walkthrough. Each clip is ONE voiceover recording. Actions are scheduled relative to the clip: `at` is seconds after the clip's voice starts; `over` is a [start,end] fraction of the clip. States are the captured screen images; targets are element boxes measured at capture time.",
  "fps": 30,
  "clips": [
    {
      "id": "c01",
      "scene": "whatsapp",
      "state": "whatsapp",
      "intent": "This video shows how to use the Drevi wholesale portal, step by step.",
      "actions": []
    },
    {
      "id": "c02",
      "scene": "whatsapp",
      "state": "whatsapp",
      "intent": "Open the message you received on WhatsApp and tap the link in it.",
      "actions": [
        {
          "type": "tap",
          "target": "wa.link",
          "at": 0.9,
          "then": "login-empty"
        }
      ]
    },
    {
      "id": "c03",
      "scene": "login",
      "state": "login-empty",
      "intent": "Type the username exactly as written in the message — not your own Gmail or email.",
      "actions": [
        {
          "type": "typing",
          "states": [
            "login-u1",
            "login-u2",
            "login-u3",
            "login-u4"
          ],
          "target": "login.username",
          "over": [
            0.15,
            0.85
          ]
        }
      ]
    },
    {
      "id": "c04",
      "scene": "login",
      "state": "login-u4",
      "intent": "Then type the password from the same message.",
      "actions": [
        {
          "type": "typing",
          "states": [
            "login-p1",
            "login-p2",
            "login-p3"
          ],
          "target": "login.password",
          "over": [
            0.15,
            0.85
          ]
        }
      ]
    },
    {
      "id": "c05",
      "scene": "login",
      "state": "login-p3",
      "intent": "Now tap Sign In.",
